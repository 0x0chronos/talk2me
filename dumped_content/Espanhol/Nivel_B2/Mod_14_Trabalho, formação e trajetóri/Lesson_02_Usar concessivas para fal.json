    {
      "id": "ac9a45c1-17e8-4f58-a64d-b6d1d6cd2212",
      "title": "Acompanhe a explicação",
      "description": null,
      "contentType": 2,
      "sequenceItem": 1,
      "items": [
        {
          "id": "b39f71a7-92a0-4e25-9adb-8a53c8f1ec06",
          "textContent": null,
          "fileUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/c8035495fa97438bb380e4c456001125_MEC-IDM_MODB2-CAP_14-AULA_02-ESP.mp4?Expires=1794099796&Signature=EJCi2WwkgNtaxgkDqeGkDDneKUpqwyEUGGnwqmjZedr4I1P8mM1ft92Vk3Ecgn7hqdVckq~ZLyebWN0nVV07hCnYh5BxauD3bSwi8rO9-6izijVglSUGUeGZrJMhCkklNfhN8906JDJJz~aSARL1Lfo~WpICt8qnzPfisvslw5AYOE8h1ElVH95K05pFqlAeBnF7jmLHIFkNHXgGscZjofZbMYrxJS-u5grzzXKELa0vpe8ICOhUlnPr6nR1pA7pukqEiyv418tYjW~6Dw2LgiOIK-b-h8Ny5sDCMKsqMzmmwJ5jrUL41Yh4huV0aXnu8SMlV9~XjMV7NMY-7aG3YQ__&Key-Pair-Id=K26R6VFB46REEJ",
          "videoUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/c8035495fa97438bb380e4c456001125_MEC-IDM_MODB2-CAP_14-AULA_02-ESP.mp4?Expires=1794099796&Signature=EJCi2WwkgNtaxgkDqeGkDDneKUpqwyEUGGnwqmjZedr4I1P8mM1ft92Vk3Ecgn7hqdVckq~ZLyebWN0nVV07hCnYh5BxauD3bSwi8rO9-6izijVglSUGUeGZrJMhCkklNfhN8906JDJJz~aSARL1Lfo~WpICt8qnzPfisvslw5AYOE8h1ElVH95K05pFqlAeBnF7jmLHIFkNHXgGscZjofZbMYrxJS-u5grzzXKELa0vpe8ICOhUlnPr6nR1pA7pukqEiyv418tYjW~6Dw2LgiOIK-b-h8Ny5sDCMKsqMzmmwJ5jrUL41Yh4huV0aXnu8SMlV9~XjMV7NMY-7aG3YQ__&Key-Pair-Id=K26R6VFB46REEJ",
