          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">La procedencia no está clara.</div>\n  <div style=\"opacity: 0.45;\">A procedência não está clara.</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/9873a2abf55c4a219ded9aee55a86368_b07-d02-la-procedencia-no-esta-clara.mp3?Expires=1794099816&Signature=sPK~jxe1xmDIxh~nSJtmPmmdIjkuIPK7VFSUV0mSzXfyzjBamioPe1TV5wwq02ZGBZf2IYZmTWHDC4B5yUAfTXtdMWj4r2E1vIZPv6xg7hr-oOfA9xgN-Y2MCzqVBrIEXJNtgZrjEtv1bExgE45Z0del4vhvjixqqoiBh-nGUJJCejQdl7fdW28HTQ-fkpwJKiUKSMAVsfDA7u5O-Hw10sqLr2xe9XTUsTUYNCjPiTpgP8HFqFIy0l-QkUq-IQto0lbIzQ-iNGEtT9NErewd~94db6VAmoUs9v3Pwcav~bwYvO9~Duj6wK4WAPxUF--QB42xkKDhS3vuxmA8lGc0sQ__&Key-Pair-Id=K26R6VFB46REEJ",
