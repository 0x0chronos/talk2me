          "id": "3033a558-77a3-4453-b55a-07e3ef23a29c",
          "textContent": "El rumor fue desmentido por la empresa al mediodía.",
          "incorrectReason": null,
          "isCorrect": false,
          "exerciseId": "02ccd5e8-e7ae-43ef-a127-81e9f96814df"
