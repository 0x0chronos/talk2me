        {
          "id": "8a78bde7-4c4a-4be8-8854-3f28beea8fac",
          "textContent": "Es una película contemplativa y avanza con calma.",
          "incorrectReason": null,
          "isCorrect": false,
          "exerciseId": "693e639a-7a37-4d95-8ede-fc1fcce5e601"
