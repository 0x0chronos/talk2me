        },
        {
          "id": "a0d2612c-806c-400a-b8f2-5853f2c5d117",
          "textContent": "<p>Se quem fala é homem:</p><p><strong>Encantado de conocerte.</strong></p><p>Em português: <strong>Prazer em conhecer você.</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/4d069ea96c8d4582a9c6f3b0f911d6e1_b02-afterwork-introduction-scene.png?Expires=1794099568&Signature=lu8-OQCh1P357uT3C4T4thA3x8S0eck3gIYlwcQHZo7KL5SSJnzWoeOHMDY~B7r2QE-w7aMurTUwODBMriRRDzptyTuxnhZAxQAaBldSOT6Ru8x-hmpy2QgzRWLX8vlOQbh6bxfOUO1oZ9DOfOWLDyoT4H54-QvL5PtFzaj5fExo0FJxvyYv7mQelExoaldkr9Go~RR4FKT59DY7IJxNJiOibT-DsHmIhYJONxMQXpp2gowQyGUQYh3D3KH8UZhfU4pI3mRtWO4s1NO~ZWzRBdSVKnwOegjMAdm6eHmU204bHQlGz6Q9hQ3VatuJxaq-3PSjero2mI4TWHuQyae-0w__&Key-Pair-Id=K26R6VFB46REEJ",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/b61beff50c8742f78ab67eb8b6c3d125_b05-encantado-de-conocerte.mp3?Expires=1794099568&Signature=f0yytWL8DhHVZY6NUkBumm4jDak7n-R5yohx-4GnI~tu132LdIY1PfWYL1N83KHfEHn-igL-pbSUYLBWIzOdsNPk5gZROmY3FMOI5W-j2QSQmY3sDitLL462FaUtfoDRnG-6y6aptslUeQPAdxoWOfzE2QR39RnpcB5n7345mw~PrlZ7zJJK3CUrNVUlf4Cv0DHWANIngY4x3hbB-xrqygcT23C7DeObwZzR5xH9fBtDDzc9JT4Itxy5SI5zMIWRZUVe1rsWLCZ7~DLd-zNt98DqhGmamcPLRir2xlSc4AZwjp2lNspS4GZqVvEpL4EIvCqa61A7zMmqzih29p9vZA__&Key-Pair-Id=K26R6VFB46REEJ"
