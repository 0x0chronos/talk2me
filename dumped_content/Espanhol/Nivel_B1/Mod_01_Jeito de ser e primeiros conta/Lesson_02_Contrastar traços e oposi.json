        {
          "id": "6719dbdf-055a-4757-bb97-7d6447d19131",
          "textContent": "<p><strong>cerrado</strong></p><p>Em português: <strong>fechado, pouco aberto</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/121f6661fb4c49b294d19bbaf734c244_b04-cerrado.png?Expires=1794099565&Signature=zDlKNbcWCCjJDwRQuG487nj7IA0lkaBnCuMfIdJU4RwXewk7mnME7bLHA8atz5rluOso3yJ0R3PN8mHTZf41u1car~s7nZNXfJURJt6Sj5GO7yn1b~iyS-m8yFT0DAzKaMulPakCLTQCbetvcouyDhbszei8omfQhrMX18oAF7nQjDXmo-Azf6OfBgIC-zPBEP2zXeheY7m1h9Wci~rv5cS~C4lmySiB5OK3FI7o0GjDO8abWP1gViGo9Ql~2o0vOnlZ0aOHheIqadljajF2D~IU5kYBMLrPomPPoFOhBu1E8ZmcRWMMJzsyrx3t6ZoJ26TAlMu0tY-Q-o5QOttXMg__&Key-Pair-Id=K26R6VFB46REEJ",
