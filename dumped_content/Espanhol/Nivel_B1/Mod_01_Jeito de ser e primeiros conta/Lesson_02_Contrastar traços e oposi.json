        {
          "id": "f7afde01-2cad-431d-9952-5e3186ebffd2",
          "textContent": "<p><strong>pesimista</strong></p><p>Em português: <strong>pessimista</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/f861ab7d78d445d9a14a45e55e80b3ef_b06-pesimista.png?Expires=1794099565&Signature=0sYc4ucpr2IsF8rqDqgQs7mBd6oR~Qg0H~nMhpxFi7xFVsbR5Xubs4FG0eiATsc8KSkjDoX3fzBz6wc30x4MDlp~tEhmmeyMOjIjC~NgmhOfT1utsbeGNnT1N4IJs~mUmOS-Cu134F~kLNMaASelTv0DJMc3yfyN6eMD6BuJ41ndhK2ruf28gZkvXD~nN4PQKr0JW8oUw036-XbS0cq4N4AeNxhGih~Tqoi2~oSzzwDiEbFrlWF-zOZB1WF6rJeM6eKrHIQFHy-ApsrjHAuLqH0GXiIP8TGWjkMv22qRg8KpzMuhy-qT44ScuijG84YQMWXvUckQ9XKOgt7I~qNYMA__&Key-Pair-Id=K26R6VFB46REEJ",
