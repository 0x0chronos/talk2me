  "contents": [
    {
      "id": "41d91874-b3bf-402b-9e55-cdbe0e480428",
      "title": "Observe a imagem, escute a expressão em espanhol e ligue a forma nova ao apoio em portugues.",
      "description": null,
      "contentType": 3,
      "sequenceItem": 1,
      "items": [
        {
          "id": "58b7ad8b-4d47-438b-a8e1-1aa2481929e0",
          "textContent": "<p>Observe a medida urbana.</p><p><strong>carriles bici</strong></p><p>Em portugues: <strong>ciclovias</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/0b237db8e1c247b2a62db528a2a73954_l02b01-carriles-bici-contexto.png?Expires=1794099662&Signature=au6zUH5bOVXI2wQ5noazMtQpcmMK7UdXFmQiRAzfzy1VWdk2DyePK0RUKeQ8CT4YA7yyLcFHcWYvNgDlTE1r4OstNjPqSrFFpg-p3cXC6JwPg77oVb8p-CXC7StNvBtVYuBGMHQ~OWJII86K0q2NTpFUPnJKzLgcvdtWSj38Rc3AtQ8chvuu5jQbXaHmHsqTQo4PnaKymmrmBDeZpaiq4tsg0BYTnJ13Kc-SU6dddzQnGsBkOJJwWWDjE--KdD0LOGFnE0uVpqp-BdJYYW8O2XFYgKzpHjObspENix-48nKUDjojVFjkqNftOlDHN~a2HW4HL2mpLW139ANavhSwCg__&Key-Pair-Id=K26R6VFB46REEJ",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/14317809840f44729b0cf6bb346cd4b4_l02b01-carriles-bici.mp3?Expires=1794099662&Signature=hGPZUeAWCmpReG2Clk~p19S0bbskPbenNAm8f8m~XzEecJAxHdS58m1A9ro3ewWXEMwH1BxQuq8kn-FCbKCF-0RC0YBmGST7iv4-pnZ5puOppdlAVwBfdl2d7h~FTiNEQ9pwyO8cOf4Vc6N8yyPCfeDCuPB6HNtGa-dnXGMQpBbFmVME3aI9CBmjIUW1676IYqGcWfUFVh5vfAKGJeRIi3hXbQfmYoTnA91kMEgAgv~v6vZn1QIqpWjY2M7uaRYm6WVEK4yuCrzpS2qpClyJgVJd3MaL0eWKqyt~5O7qbr01E0TZhJmZgXsUjWFwL7b2VKcPg7Kup0zjRtB4wr~V4A__&Key-Pair-Id=K26R6VFB46REEJ"
