    {
      "id": "78ee1efc-0f21-4e97-9608-fedda353eb31",
      "title": "Troca curta antes do provador",
      "description": "<p>A cliente ajusta a escolha em dois passos: primeiro a talla, depois o color. O atendimento responde com frases curtas e fecha com a localização do probador.</p>",
      "contentType": 7,
      "sequenceItem": 4,
      "items": [],
      "dialogue_bubbles": [
        {
