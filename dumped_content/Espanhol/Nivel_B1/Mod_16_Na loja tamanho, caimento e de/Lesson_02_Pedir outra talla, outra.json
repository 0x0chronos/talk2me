        {
          "id": "7f6b640d-6b50-4183-87c4-57980a5ea5ea",
          "textContent": "<p><strong>Sí, te la traigo.</strong> indica que a opção existe e o atendimento vai buscar a peça.</p><p><strong>Solo queda en negro.</strong> limita a escolha a uma única cor disponível.</p><p><strong>Los probadores están al fondo.</strong> fecha a busca e move a interação para o lugar da prova.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
