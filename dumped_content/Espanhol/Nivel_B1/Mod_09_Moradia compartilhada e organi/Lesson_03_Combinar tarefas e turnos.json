    {
      "id": "e1415b23-ade3-4dc6-9967-0cdac95ccb6e",
      "title": "Observe a cena, escute a expressão e ligue o espanhol à ação da casa.",
      "description": null,
      "contentType": 3,
      "sequenceItem": 1,
      "items": [
        {
          "id": "dc9c8826-0e8e-4ebb-8e11-33ec3af9ad08",
          "textContent": "<p><strong>poner la mesa</strong></p><p>Em português: arrumar a mesa para comer.</p>",
          "fileUrl": null,
          "videoUrl": null,
