    },
    {
      "id": "047360e9-e088-4a51-90a4-739b30e381a1",
      "title": "Compare as três frases e observe o foco de cada uma antes do mini diálogo.",
      "description": null,
      "contentType": 1,
      "sequenceItem": 6,
      "items": [
        {
          "id": "9f43472f-5b1b-4ebb-bb1a-ca463a76adec",
          "textContent": "<p><strong>Es indie.</strong> nomeia o gênero.</p><p><strong>El ritmo es pegadizo.</strong> comenta o ritmo.</p><p><strong>La letra me aburre.</strong> comenta a letra.</p><p>Em uma conversa breve, você pode dizer primeiro o estilo e depois acrescentar a sua reação.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
    },
