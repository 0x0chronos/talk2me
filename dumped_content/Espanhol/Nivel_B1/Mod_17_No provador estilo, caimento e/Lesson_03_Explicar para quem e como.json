        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
    },
    {
      "id": "ff0b73e2-b4c4-4ccb-9bd8-037fb8d0e77a",
      "title": "Fechando a explicação da compra",
      "description": "<p>O diálogo entra agora porque as quatro peças principais já apareceram em separado. Aqui, o foco é ouvi-las juntas sem aumentar a carga.</p>",
      "contentType": 7,
      "sequenceItem": 7,
      "items": [],
      "dialogue_bubbles": [
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">¿Es para ti?</div>\n  <div style=\"opacity: 0.45;\">É para você?</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/2ddbeb51d32542dfb86462bf59165529_l03b07-linea-01.mp3?Expires=1794099656&Signature=ohL7Xv77JvcF6~tzot~~nQzttQxbzXb19iLVQ6ABb6eAHn9QKj2r5vyuNbJfGrLtYoa~oVlGG3UEF418~iaey3oJh0mJPFHzixloMPa~8OKUsENfU5XWtKrBaDE-XeYnBUQHwaBKh2qjenCZyuhgPxzxfvOehdukQxZwaG5B1J32ghl8eL3Tacfe~cnDPpgVgr692vYfC9IvXwtzIlPYR~zgcXT9Vk6XeEXq0aYNi0oizMJ7qnwqgR4QMCRQOoc6Mp4~RGpO4NjhaQW~u6xgGMUYFZ2Uv5C9zHZRD1G8py374UH0KJ3Y9LbKQFjaXkgQI28rp2m5AMRMw47TmjhUVg__&Key-Pair-Id=K26R6VFB46REEJ",
          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">No, es para mi hermana.</div>\n  <div style=\"opacity: 0.45;\">Não, é para a minha irmã.</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/c1e5c146740e4a79a0d7dc80c9d870db_l03b07-linea-02.mp3?Expires=1794099656&Signature=e93gkWSZVNNNXHGbvcdMDcSvUKWY3d2F9IflhqSvytXqerg9vYMFvaZYyk0bFKhLmdR98RIvrKQ9X6fJ5D3afHCpl82v42Ao5ywu0qDiUNlBfXPysdojd1z2Ayoh7JPdh15Sh1V0y~3UXnBVNgvW~MuqChpmMSHoUy7pN64P4QmXjGwaaq6a-t6IAwYnN7KmZyKUyBq3bPIalyNz4XqQJ9ln2z-LymD8OLGvB9sk0HTOTO~kSl0sbGfbXz8lFiCYWTZ-Os1ex5nPuRXpZWLk2T9TAOwXEhIAJ2BBeHco9Dg72qmzlFfwQe1Rao69GtEGTtKFkTJWwiBjn-yHrsCnoA__&Key-Pair-Id=K26R6VFB46REEJ",
          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">¿Es para una cena?</div>\n  <div style=\"opacity: 0.45;\">É para um jantar?</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/21408de62def4870bdf2c922e5be3c45_l03b07-linea-03.mp3?Expires=1794099656&Signature=YkBl3VZHe2wdIYifhogb1G09qZYOVzoxy20NhB0mKY6goKgY9ly~cj7QcRq7bdhEzJGi1pj5G-9xSsKMfzDsiJhHE5XwuHl7cv~5bsrqR-UzIwFyUqbilZd1v0ntoST0srCsDdV2KT4XI-j~3JPAY3tlfByEceTebQuNsCRWWpuXI4Gc4wHkLewychhc6iA~zIEG0PARCeYgbWJ5Ng0358bxmEOlR6fUkF5D2Eq1XpyNflg12qKrfPEmMme2Ue9VfphhmPilpEtcKuJdlX~XwCpuOAi2~48zPbwsV5PhsIrtpq7oHCIQ2VVj4dCWxlvB9G6HmWAEKhZJgNW6m1dlgg__&Key-Pair-Id=K26R6VFB46REEJ",
          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">Sí. Llega por correo y tiene que llegar para el sábado.</div>\n  <div style=\"opacity: 0.45;\">Sim. Chega pelo correio e tem que chegar até sábado.</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/e93183b1e15a4839a3a203fec6e656cc_l03b07-linea-04.mp3?Expires=1794099656&Signature=avdnLGWSggzGk76tXqo4kz-QwNKagF97fHnOGuSJNXRxRjoh7pqrTr5Uw7XGv0dHWnqSupleEldCwa5M-9Woh7cVIjLZimwgzTtRbWUwnAkGS84oIcWXMAAObm1BBiaVPPYQVMBWPqoi~GSTeFkrtCMhpFv5TxwATN~3yBnIhvlYwwp53fe4cTCv2NlNpUBhg5P9whibpBJpGjE5vEB2tD~K5yy7W2E2c3huHPatyMnd-4feJCIgVsDiS01KicsWiiVa0hqe4RbyvouQyph4TA724WF9FHxFm7hUzLi4jqUl8YXlUyQlFUqlYyZzloSedkWyvnAF9Ab~mdGJX-rDCA__&Key-Pair-Id=K26R6VFB46REEJ",
