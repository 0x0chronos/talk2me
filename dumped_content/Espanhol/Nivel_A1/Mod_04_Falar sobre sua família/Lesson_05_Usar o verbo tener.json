  "contents": [
    {
      "id": "e2db323d-e728-4be0-9d25-6c7887184829",
      "title": "Observe a imagem, escute a frase e ligue `tengo` a uma fala sobre mim.",
      "description": null,
      "contentType": 3,
      "sequenceItem": 1,
      "items": [
        {
          "id": "715e1877-73cd-49c4-a840-0295217d9ec7",
          "textContent": "<p>Primeiro, a frase fala de mim.</p><p><strong>Tengo el pelo rizado.</strong></p><p>Em português: <strong>Tenho o cabelo cacheado.</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
