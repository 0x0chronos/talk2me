          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        },
        {
          "id": "53d92bbf-ac6b-4ffa-b36c-c087ff5f532e",
          "textContent": "<p>Cartão 2</p><p><strong>Mi padre es Raúl.</strong></p><p>O familiar muda, mas <strong>mi</strong> continua na frente.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
