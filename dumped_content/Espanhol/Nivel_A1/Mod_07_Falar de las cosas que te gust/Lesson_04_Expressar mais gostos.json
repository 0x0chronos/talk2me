    {
      "id": "064b25c9-2f63-4790-bdc1-9082ed13d959",
      "title": "Compare as duas linhas e veja onde no aparece.",
      "description": null,
      "contentType": 1,
      "sequenceItem": 6,
      "items": [
        {
          "id": "cdd9e149-d1ac-479b-8805-698718f56130",
          "textContent": "<p>Veja o contraste.</p><p><strong>Me gusta el café.</strong></p><p><strong>No me gusta el tenis.</strong></p><p><strong>no</strong> entra antes de <strong>me gusta</strong> para negar a preferência.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
    },
