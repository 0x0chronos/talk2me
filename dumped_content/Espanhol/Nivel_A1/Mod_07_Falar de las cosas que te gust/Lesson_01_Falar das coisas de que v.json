        {
          "id": "7d332a95-b681-41ee-b927-6ab0a055c0ee",
          "textContent": "<p>Olhe a cena e escute a frase.</p><p><strong>Me gusta viajar.</strong></p><p>Em português: Gosto de viajar.</p>",
          "fileUrl": null,
          "videoUrl": null,
