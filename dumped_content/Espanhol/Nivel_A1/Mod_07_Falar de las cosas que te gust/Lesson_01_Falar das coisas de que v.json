    {
      "id": "43725e32-271b-4ba3-b046-461e957e38a7",
      "title": "Escute os dois perfis reunidos e conecte as frases a um uso real do dia a dia.",
      "description": null,
      "contentType": 6,
      "sequenceItem": 8,
      "items": [
        {
