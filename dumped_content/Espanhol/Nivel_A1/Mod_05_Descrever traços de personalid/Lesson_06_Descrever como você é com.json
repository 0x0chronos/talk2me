        {
          "id": "a1e6d1e4-2dff-4b7a-93cc-aecb829f9af9",
          "textContent": "<p><strong>Soy trabajadora.</strong></p><p>Em português: Sou trabalhadora.</p><p>Versão mínima: uma característica só.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/405f6ec4e35d499b9e026ef79dfe43c2_b04-soy-trabajadora.mp3?Expires=1794099423&Signature=ySzZhvNsU~oCdnCaeBG~swVHFR6rSQnhfAQXpt6ej8KLpSAPtvK1lM90bGbbIphUZ3CrBNWDGizBoIYPzf-WO8jeMndLXU4wdGncBR~7YYn68fY3-6OgjXZvz7IheX-gu-oryaoH430dUu1mfvf3PRiT2o0RKFjjkWvX3giWgVqr4gCU0EYlpZPhkGJ6hFp7ADaW3cGiXNq6pdW8se5vPFOa5-w1rWgORlAjH-qrLCs0BFdJWNwChjpT-s7vaQWlSDhvf7O2nuEdT6vQ0oN-wVSBAWVBOYloLep2LKORrh~I4gERLQPXmwb868N-utdxeILLPofnnW1wD54A2xURlg__&Key-Pair-Id=K26R6VFB46REEJ"
        },
