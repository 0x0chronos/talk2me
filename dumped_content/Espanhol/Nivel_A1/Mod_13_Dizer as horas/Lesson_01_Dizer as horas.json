        {
          "id": "35aa403f-77df-4c99-a751-57fbd9a8d553",
          "textContent": "<p>Uma pergunta muito comum no dia a dia:</p><p><strong>¿Qué hora es?</strong></p><p>Em português: Que horas são?</p>",
          "fileUrl": null,
          "videoUrl": null,
