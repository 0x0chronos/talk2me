      "contentType": 1,
      "sequenceItem": 3,
      "items": [
        {
          "id": "e2789b3f-04f5-4330-8b49-9e75b36c03b9",
          "textContent": "<p><strong>por aquí</strong> ajuda a perguntar por algo que fica perto de você.</p><p>A ideia não é pedir um endereço completo, mas saber se esse lugar existe nas redondezas.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
