          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">Soy de Brasil.</div>\n  <div style=\"opacity: 0.45;\">Sou do Brasil.</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/c47c6626df2d44e8b573d73d4271562b_b08-d02-soy-de-brasil.mp3?Expires=1794099401&Signature=E2nHyuvoyAkDB88gaDPT~nIinuqeANQ9TijwjwHpr5Njy6jfeqF6DRLpGqyl9MWm1wN0Vo3wtK~CY50OJdla4URBr85sWybr5juRz0ISJfov2Pp8sw9s~hscPtQB~KQaLaLnrUcPIQv2xq51AYcVzLEeaLuhvVgtKCFSkMKeGPsgV-yjHK75V77XKLjOrr2nyy-YZHWAfmmaW7LYcLOjQHOvqzk1sZ9ZXOI3324O4anfHlv3skKtnJxyBSeeFCPH4qKfIgm0t54b6KZBcxW-7nHOvJDYzOo~fwk1lz5-vzDBKLd~bwLXhpopxr2fVm~Cq62cPb~JWXLcNY6cGsgUTg__&Key-Pair-Id=K26R6VFB46REEJ",
