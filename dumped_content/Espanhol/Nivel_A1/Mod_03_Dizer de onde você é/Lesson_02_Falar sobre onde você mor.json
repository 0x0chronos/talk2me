        },
        {
          "id": "d67ef786-8def-42fe-b4ed-949d55ef33c2",
          "textContent": "<p>Exemplo 2</p><p><strong>Vivo en Santiago.</strong></p><p>Eu moro em Santiago.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/1988970078fc42c0a6df4bb62c162c8e_b04-vivo-en-santiago.mp3?Expires=1794099400&Signature=Jf~U70uhJLL9E8Ud4K6UigoKBFMv2hs2HklnaXtat3UCWRgmV5a5h1p67TJrY2MIdMSFRQsnPAUs7xkSjTUAWfk~1WXLP09f-DGFejIcPg2Gg19m4MU0n-SMAUgUSKxoOdTEUsK8-KgsZ2NAk~sz2oaC~pFcj4hx3PPfsQikn6W3EuZUiKPz2COCJVTuxaeoM6V1iha6BWjTGgetdd0~QFAhMuq7PU0Ru11qkfFCZRUZh-tNuBZ95Axi34Qg2BAdhRO7xcteqRbSKOSDzzgujfgcP1ptrafCwO6Ipj3ofKC3ZYdplQRapt0cRgS9Di7NTe7NgBR5Nyw00WBVxxCytg__&Key-Pair-Id=K26R6VFB46REEJ"
        },
        {
          "id": "d3488e2b-8b06-4424-a8ef-b334bfa734a5",
          "textContent": "<p>Exemplo 3</p><p><strong>Vivo en Ciudad de México.</strong></p><p>Eu moro na Cidade do México.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/d3b5649af1ae4dfda3c690e7f6819ade_b04-vivo-en-ciudad-de-mexico.mp3?Expires=1794099400&Signature=Z~wkzDaDYgAs988X7Go~an3cwy0mN53ibhhVcgNc3sbzoEWBH8PwY63~cYGnXdpI~oS56G3hqINkTrJktr07ZTKsohe4WA-Wt06~DB9uvGNZV6FIjf~6okjsq~vPJkvd1W1Xwe3SeB6wqQspuR-fYg9nDF4V3Abg1nOqEQtzuizZaaBm0eadqOcTRRAgEBsT66fcf0mgFbBgyK2tM3~V5P18s3CGwvxx0PoOHLWJhroF4xaRsZg5GGJdRKtPIasEUEIKLpkacp~is4nk2KIlkdvxxk~U6TkO70Ydr2FMCINZCxAd9DQ~ahYTTIk5NOw-Arp9RlflwP0jSTtYklTRDw__&Key-Pair-Id=K26R6VFB46REEJ"
        }
