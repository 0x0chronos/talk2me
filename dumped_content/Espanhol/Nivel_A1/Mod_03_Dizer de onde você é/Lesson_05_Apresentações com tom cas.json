          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">¿De dónde es usted?</div>\n  <div style=\"opacity: 0.45;\">De onde o senhor ou a senhora é?</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/0f46510bba1e4254ba9c28ee96cb186c_l05b06-d03-de-donde-es-usted.mp3?Expires=1794099403&Signature=LwqloczeGOyhGY8x2AO9EqoEuoBuzVST05iJ7WQDPRARyZyuSDK1m-DHwj3ty8YFoTbbku2qU8anaXsbrM38Y59hattMDxe2655PzZfVeD9Ffx67ot5P8E4kvyT~~FELqE60lUmacvUX9TN8F2j2Ak7l67PivagLB45I3H-rtvb4zcioSCY1slVr35rsXfj-1VXpylp3XRZCLJUqyQObHUdK6m2oNmufRrhdlxiiPnsmpK-Pco4FI9HpObStUAwRuxf-POiySVkNhhI-FNxVs7hiEfBvjwAvxUAYF8kD66LIBlHH0WxtqmtW~USIq9Uooy~5wioEU7smRmWNRn0hiw__&Key-Pair-Id=K26R6VFB46REEJ",
          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">Soy de Chile.</div>\n  <div style=\"opacity: 0.45;\">Eu sou do Chile.</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/f187300611f94715a9f166b9fe316f04_l05b06-d04-soy-de-chile.mp3?Expires=1794099403&Signature=gQ7bDbYhsqF7q-5QFyefBqIW-X9iYByD0Iy8zxQzAaR2SbFDsUmbB~SH6ffjaQ8Yh-ol9nR4unO3BBWhmp9sNtArke5Bfp4ymysub7ZxjcWnbfx6VoFtpatyrw4Cz2n3MVM8fKDOqLIsC2DsL1DReZDup5rxADBc-MEfYAz7Klra~r4HYsn7T7jefHTSGUfJF7zyesK8EWucFJ2PSPzGY9FPj0E3Ckq90w7Y42oPvaiIhcu849DCbd9vltWyDOaoeLxMMOMRszNrJ4~IfONDwsCxwLijMmC2NbYJhnnNlfly0-yqz5~kdZqueUIQTGyd5xjvo9y1nGY4cuxZna~OSw__&Key-Pair-Id=K26R6VFB46REEJ",
