      "contentType": 1,
      "sequenceItem": 2,
      "items": [
        {
          "id": "17c753c9-6ea8-4c09-9868-2823cfca02e2",
          "textContent": "<p>Use <strong>quedar con amigos</strong> quando a ideia é combinar de ver os amigos.</p><p>Essa expressão cabe bem em planos simples, como uma saída rápida depois da aula ou do trabalho.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
