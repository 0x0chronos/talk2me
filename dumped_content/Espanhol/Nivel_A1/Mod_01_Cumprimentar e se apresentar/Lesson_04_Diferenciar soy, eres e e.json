          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">¿Eres Marta?</div>\n  <div style=\"opacity: 0.45;\">Você é Marta?</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/ac74f711ab6e4ee5a4ca92d938eeb541_b08-d03-eres-marta.mp3?Expires=1794099391&Signature=ZLEoJtngXQqWnlRAtHcH1raNFS2g04oYsxnvKvD7P2p6coEPM6RUkPmIREIHCoZ1ImE4ShFoy8mcQuL0GNCHaaqLJJGRiP0xfcU8DWceYlpG4Z4afwSW5Wy2Mjpne234Vw1FCJ41eYTV5CIfnKCggzUYCmVEFUOAsn7n69aXAztVTpLC5KISY42acpmRqHMDjF6npwoRSRaeQmO3yfLgYN38wYs5CO6SUozBgBqqSAWlaKuXqLlAG4MMjN766HpXU0sBlgowZW4mP9uzC7-UQWgN3J6pN4WFUareZN~miYst9W8eUMKp1m8He7ZRsiUZre~L4kUIOspmSiVsl~VXLg__&Key-Pair-Id=K26R6VFB46REEJ",
          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">No. Ella es Marta.</div>\n  <div style=\"opacity: 0.45;\">Não. Ela é Marta.</div>\n</div>",
