      "contentType": 6,
      "sequenceItem": 7,
      "items": [
        {
          "id": "317a671e-b7e1-4dce-bf12-93ae39212d7e",
          "textContent": "<p>Agora chegue à sexta-feira.</p><p><strong>viernes</strong></p><p>Tradução: sexta-feira.</p>",
