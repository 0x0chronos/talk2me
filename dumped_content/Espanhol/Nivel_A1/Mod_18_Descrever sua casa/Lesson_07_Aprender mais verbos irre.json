    {
      "id": "2d8f748b-04c8-4f75-9678-f18f319d7955",
      "title": "Leia a nota curta e repare na mudança do verbo com yo.",
      "description": null,
      "contentType": 1,
      "sequenceItem": 3,
      "items": [
        {
          "id": "c4af9e39-9c05-449e-bb26-1e9a263d56f5",
          "textContent": "<p><strong>poner</strong> vira <strong>pongo</strong> com <strong>yo</strong>.</p><p>Use <strong>yo pongo</strong> quando você fala de colocar ou arrumar algo em casa.</p><p>Exemplo comum: <strong>Yo pongo la mesa antes de cenar.</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
