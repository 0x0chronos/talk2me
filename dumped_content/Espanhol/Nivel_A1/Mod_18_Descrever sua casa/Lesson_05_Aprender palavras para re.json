  "contents": [
    {
      "id": "e6016820-58c5-46ec-bbc4-18a90f003bd7",
      "title": "Observe a imagem, escute o áudio e associe a expressão em espanhol ao cardápio.",
      "description": null,
      "contentType": 3,
      "sequenceItem": 1,
      "items": [
        {
          "id": "6380b159-75b2-44ef-9653-13e5d71c4211",
          "textContent": "<p>Observe a palavra do restaurante.</p><p><strong>la carta</strong></p><p>Em português: o cardápio.</p>",
          "fileUrl": null,
          "videoUrl": null,
