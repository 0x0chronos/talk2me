    {
      "id": "8791620d-8170-4b36-b994-ba227b9a60c8",
      "title": "Leia a nota curta e ligue a pergunta ao grupo certo.",
      "description": null,
      "contentType": 1,
      "sequenceItem": 2,
      "items": [
        {
          "id": "92d937fe-8145-4c5b-b9fb-63190bd1fe67",
          "textContent": "<p><strong>ustedes</strong> aponta para as pessoas com quem você está falando.</p><p>Aqui, a pergunta vai para um grupo, não para uma pessoa só.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
