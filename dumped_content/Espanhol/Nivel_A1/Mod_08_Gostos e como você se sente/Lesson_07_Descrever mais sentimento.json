      "items": [
        {
          "id": "3257f44e-3187-45dc-b7eb-f44e33673f19",
          "textContent": "<p><strong>preocupado / preocupada</strong></p>\n<p>Em português: preocupado / preocupada.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/d4ed928e9f604eb595f6a62b66807658_b12-preocupado-intro.mp3?Expires=1794099441&Signature=A1QKs0u02vh4Cwe4TLLqPQnM-yAImMIF1jtPxaAPfEW17yII3a77CKyQ9uG1iai5hkW6sMRO2-n~BpMX5MdAT0DAEiUHOZqSZLPQritwutKWSQQTgesuLwohW0AJxOROFfg31DrRzTVEAGU7OVvDuYrlIuPWd6WuyB2cAU~OAWHWpVVdBh5WbtC-lcQUzO9TdMlI0KWvYg0jo3acjzNCyBnbdabCTLaTyT7QNM3ZkPUCc2zjYJ6FYZmu2VABlgei-3E4y4hn8BSOdjew~e0kbirE17SxRVEh90~y8flw9mffLqoTgvHo1nFrlkdYL0Q1-w~AYJc1-~emD-3iFyXTWw__&Key-Pair-Id=K26R6VFB46REEJ"
