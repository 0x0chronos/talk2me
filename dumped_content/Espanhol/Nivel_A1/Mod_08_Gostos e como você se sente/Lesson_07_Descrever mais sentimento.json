      "contentType": 1,
      "sequenceItem": 1,
      "items": [
        {
          "id": "a1c5e59c-618e-4cde-aedf-9431eb358894",
          "textContent": "<p>Você já viu que <strong>estar</strong> ajuda a falar de como alguém está.</p>\n<p>Agora o foco é ampliar as palavras que entram nessa estrutura.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
    },
    {
