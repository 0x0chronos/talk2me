    {
      "id": "bf2ea813-ad55-41b3-9234-d7fadb886f66",
      "title": "Leia a nota e observe quais pronomes combinam com essa forma.",
      "description": null,
      "contentType": 1,
      "sequenceItem": 4,
      "items": [
        {
          "id": "5473f392-2db7-4b66-b9b3-2f9917af00d2",
          "textContent": "<p><strong>están</strong> combina com <strong>ellos</strong> e <strong>ellas</strong>.</p><p>Use essa forma quando você fala de outras pessoas.</p><p><strong>Ellas están contentas.</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
