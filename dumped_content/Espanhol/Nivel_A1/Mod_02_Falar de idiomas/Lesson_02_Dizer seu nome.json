    {
      "id": "3988d2a4-2cc3-432e-8a51-fdc5d7287e50",
      "title": "Troca curta",
      "description": "<p>Agora veja as duas frases funcionando juntas em uma conversa bem curta.</p>",
      "contentType": 7,
      "sequenceItem": 5,
      "items": [],
      "dialogue_bubbles": [
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">Hola. ¿Cómo te llamas?</div>\n  <div style=\"opacity: 0.45;\">Olá. Como você se chama?</div>\n</div>",
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/05f02ed1880f48a2aef7c80935f7c5e9_A1_M002_L02_audio_ee6544d0_l02b01-como-te-llamas.mp3?Expires=1794099393&Signature=H7WrZ6fStqra6m55gb-E3EyzT9Qre25mkKiCkli01HM1aaVc7Tn73CEhh~i3SGwt3rnniMRQFYrHcVBUcMeI6A1UHYfD-Wgvmy6yJ4mhqlujMWtW8wdBAqGm~mj~O0xG4SDnrrBd1pLFinxduwix3z-vUv~5fNViWHviEqJgD4YjZKAE042sFRVnHThqNty~UPzWsxtS~bHMuCve5ZH8-o38hUPIfMQKOM2u46XysI-EPfrJ7DgDKnTErpf12icT3icW5fmh~0TSBTk1J4Rg21Lsiffbt8PjTLmwfYAhADgbBBJ3t7S8CztNxDed4vg2cCWNbh6X5g47NBdXwmeHbw__&Key-Pair-Id=K26R6VFB46REEJ",
