    {
      "id": "1adf6b0e-8d8c-4d90-9c92-0362924aa04b",
      "title": "Leia a observação curta e associe a palavra a uma situação real.",
      "description": null,
      "contentType": 1,
      "sequenceItem": 9,
      "items": [
        {
          "id": "27b5bf8f-8476-4448-88b1-9c5f31e005c0",
          "textContent": "<p><strong>el periódico</strong> é o jornal impresso.</p><p>Ele pode aparecer em situações simples, como ler no banco da praça ou no café da manhã.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
