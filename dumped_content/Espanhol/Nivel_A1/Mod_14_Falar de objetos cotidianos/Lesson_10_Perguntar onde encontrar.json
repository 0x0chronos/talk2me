      "contentType": 1,
      "sequenceItem": 3,
      "items": [
        {
          "id": "e1ef10ca-d241-450f-81b2-45503eb6a68d",
          "textContent": "<p><strong>¿Hay ... por aquí?</strong> serve para perguntar se um lugar está perto de você.</p><p><strong>por aquí</strong> passa a ideia de <strong>aqui por perto</strong>, sem pedir uma localização exata.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
