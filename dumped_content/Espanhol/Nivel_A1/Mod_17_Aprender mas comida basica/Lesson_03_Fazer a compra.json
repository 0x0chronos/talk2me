      "contentType": 3,
      "sequenceItem": 2,
      "items": [
        {
          "id": "767cd539-d384-4ad8-9ba8-573e2d513fae",
          "textContent": "<p>Escute e observe o nome da loja.</p><p><strong>panadería</strong></p><p>Em português: <strong>padaria</strong></p>",
