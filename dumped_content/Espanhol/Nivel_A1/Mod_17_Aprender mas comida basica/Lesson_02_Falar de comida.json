      "contentType": 6,
      "sequenceItem": 7,
      "items": [
        {
          "id": "689c401b-6048-41fc-86a7-8833e05a75b8",
          "textContent": "<p>Escute e acompanhe a frase.</p><p><strong>No como carne.</strong></p><p>Em português: Não como carne.</p>",
