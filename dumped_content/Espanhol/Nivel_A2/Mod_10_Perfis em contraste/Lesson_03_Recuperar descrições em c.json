    {
      "id": "096445a0-83ed-47a3-84f8-00578d6f64df",
      "title": "Leia a observação e note por que a frase continua falando do perfil de Diego.",
      "description": null,
      "contentType": 1,
      "sequenceItem": 4,
      "items": [
        {
          "id": "f91a9c00-14fb-4d08-9ac7-3373d3a80274",
          "textContent": "<p><strong>Es generoso</strong> fala do jeito de Diego.</p><p><strong>Ayuda a todos</strong> reforça esse traço com uma ação visível no contexto.</p><p>Mesmo com hotel e chegada na frase, o foco continua sendo como ele costuma ser.</p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": null
        }
      ],
      "dialogue_bubbles": null,
      "glossary": null
