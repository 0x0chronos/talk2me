  "contents": [
    {
      "id": "3b9433bf-6548-4bdc-b4a4-af67ab7ad6b0",
      "title": "Observe a cena, escute a frase em espanhol e ligue a linha do retrato ao sentido em português.",
      "description": null,
      "contentType": 3,
      "sequenceItem": 1,
      "items": [
        {
          "id": "0c241df4-d0e7-4b9c-8db8-919094069a9b",
          "textContent": "<p>Observe a personagem desta aula.</p><p><strong>Carla es generosa.</strong></p><p>Em português: <strong>Carla é generosa.</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
