          "translation": null
        },
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">Claro. Envíame la versión final cuando puedas.</div>\n  <div style=\"opacity: 0.45;\">Claro. Me envia a versão final quando puder.</div>\n</div>",
