      "contentType": 3,
      "sequenceItem": 1,
      "items": [
        {
          "id": "82bb31d4-0009-428e-986d-218a9e32e88d",
          "textContent": "<p>Observe o lugar da cena.</p><p><strong>El colegio.</strong></p><p>Em português: <strong>O colégio / a escola.</strong></p>",
