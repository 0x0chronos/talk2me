  "contents": [
    {
      "id": "0a1da0a0-7784-43b1-845c-ad6a2f5664ac",
      "title": "Observe a frase, escute o áudio e ligue a abertura ao contexto da apresentação.",
      "description": null,
      "contentType": 3,
      "sequenceItem": 1,
      "items": [
        {
          "id": "65fb2419-3693-412d-822d-122adfa53015",
          "textContent": "<p>Comece pela abertura curta do perfil.</p><p><strong>Hola, soy Valeria.</strong></p><p>Tradução: Oi, eu sou Valeria.</p>",
          "fileUrl": null,
          "videoUrl": null,
