    {
      "id": "e17abf22-5d08-482a-b46c-43c33066557c",
      "title": "Conversa no apartamento",
      "description": "<p>As falas repetem a expressão central da aula e deixam clara a divisão das tarefas.</p>",
      "contentType": 7,
      "sequenceItem": 5,
      "items": [],
      "dialogue_bubbles": [
        {
          "text": "<div>\n  <div style=\"font-weight: 700;\">¿Qué hacemos hoy con las tareas de la casa?</div>\n  <div style=\"opacity: 0.45;\">O que fazemos hoje com as tarefas da casa?</div>\n</div>",
