      "glossary": null
    },
    {
      "id": "50589d7c-a863-447c-a6a3-4b7cc4656421",
      "title": "Escute a frase e observe como ela responde ao que a pessoa está fazendo agora.",
      "description": null,
      "contentType": 6,
      "sequenceItem": 6,
      "items": [
        {
          "id": "b9139340-fb53-4346-b975-430e11f71e50",
          "textContent": "<p><strong>Me estoy cambiando para salir.</strong></p><p>Em português: <strong>Estou me trocando para sair.</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
          "audioUrl": "https://d2tew3rxpxsvy8.cloudfront.net/content/037c723d59d44fd6a3d6c9fa174662f3_l03b05-me-estoy-cambiando-para-salir.mp3?Expires=1794099536&Signature=lB83iI-YYRQ3oqHCP5QCUm5eCGo1hLgbhs6rpao9njfx--5LtHgKhgQ0~VftF4I7UQhcl~Om5Lsl~RKi0kMgVO2ElnCqEV2AnREkhhq~xm9vXkQARJVzLYtj1CW4P5-DrXRberdSNKlDT6mxly834fsb5VWzLubcE8f~Eau7~BCdP3DSA~Mip4kOMkWkcKojk0zc4A53FxaCRcFEuUNeWHM9VauxYAzQ1QZwA~iGz6gFyhDaGbqo49-RhEp86UWUgKb9DBqIAD0JiQ8rNIiDlGOoxNJP6EVA07Yi7mG-9JddU2ZhgSXb0Y2F4-9g9cCdEiWBd73ESRy~-mGDKXhZXw__&Key-Pair-Id=K26R6VFB46REEJ"
