    },
    {
      "id": "75a1bf18-cbd2-4dd5-8d19-df25ea9ecaa9",
      "title": "Escute a resposta e observe como ela situa a ação em andamento.",
      "description": null,
      "contentType": 6,
      "sequenceItem": 4,
      "items": [
        {
          "id": "053a0d3a-9af2-429e-893c-3b7bc1584261",
          "textContent": "<p><strong>Estoy llegando al café.</strong></p><p>Em português: <strong>Estou chegando ao café.</strong></p>",
          "fileUrl": null,
          "videoUrl": null,
          "imageUrl": null,
